<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="recordings/" />
        <exclude
            domain="file"
            path="reference_fallbacks/" />
        <exclude
            domain="file"
            path="reference_models/" />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="recordings/" />
        <exclude
            domain="file"
            path="reference_fallbacks/" />
        <exclude
            domain="file"
            path="reference_models/" />
    </device-transfer>
</data-extraction-rules>
